#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail

readonly APP_NAME="${0##*/}"
readonly VERSION="1.5.0"

readonly COLOR_CYAN=$'\033[1;36m'
readonly COLOR_MAGENTA=$'\033[35m'
readonly COLOR_RESET=$'\033[0m'

function fz::env()
{
	local var=""
	local vars=""

	vars=$( env | sort \
		| awk -F= -v c1="${COLOR_CYAN}" -v c2="${COLOR_MAGENTA}" -v cr="${COLOR_RESET}" '{ value = substr( $0, length( $1 ) + 2 ) ; gsub( /\033/, "\\E", value ) ; printf "%s%s%s=%s%s\n", c1, $1, c2, cr, value }' \
		| __fz::fzf --ansi --bind="ctrl-a:select-all,ctrl-space:select-all" --multi --prompt="env > " --query="$*" --reverse --select-1 \
		| cut -d= -f1 \
	)

	while IFS= read -r var ; do
		[[ -z "${var}" ]] || printf "${COLOR_CYAN}%s${COLOR_MAGENTA}=${COLOR_RESET}%q\n" "${var}" "${!var}"
	done <<< "${vars}"
}

function fz::kill()
{
	function __fz::kill::isSignal()
	{
		local signal="${1}"

		[[ "${signal}" == --* || "${signal}" == [0-9]* ]] && return 1
		builtin kill -l "${signal#-}" &>/dev/null
	}

	function __fz::kill::kill()
	{
		local signal="${1}"
		local pid="${2}"
		local msg=""
		local returnCode=0

		msg=$( builtin kill "${signal}" "${pid}" 2>&1 ) || {
			returnCode=$?
			printf 'kill: %s\n' "${msg#*: kill: }" >&2
		}

		return ${returnCode}
	}

	local signal="${1:--SIGTERM}"
	local selection=""
	local key=""
	local pid=""

	__fz::kill::isSignal "${signal}" || return $?
	signal=$( printf '%s' "${signal}" | tr '[:lower:]' '[:upper:]' )
	[[ "${signal}" == -* ]] || signal="-${signal}"  # make it "-SIGNAL"

	selection=$( ps aux \
		| __fz::fzf --exact --expect="enter,ctrl-k" --header=$'\n[ ENTER ] ..... kill '"${signal}"$'\n[ CTRL + K ] .. force -SIGKILL\n\n' --header-lines=1 --prompt="kill ${signal} > " --select-1 --tac
	)

	key=${selection%%$'\n'*}                        # fzf --expect outputs the key pressed on the first line
	selection=${selection#*$'\n'}                   # remove the key line, leaving the selected process
	pid=$( awk '{ print $2 }' <<< "${selection}" )

	case "${key}" in
		enter) ;;

		ctrl-k)
			__fz::confirm "Kill ?\n\n\tSIGKILL ( ${COLOR_CYAN}${selection}${COLOR_RESET} )" || return 0
			signal="-SIGKILL"
		;;

		"")
			return 0 ;;                             # fzf cancelled
	esac

	__fz::kill::kill "${signal}" "${pid}"
}

function fz::man()
{
	# shellcheck disable=SC2016                     # SC2016: Expressions don't expand in single quotes, use double quotes for that.
	local fzfPreview='awk '\''{ gsub( /[ (),]/, " " ) ; print $2, $1 }'\'' <<< {} | xargs man'
	local binBatcat=""

	binBatcat=$( command -v batcat || command -v bat || : )

	[[ -n "${binBatcat}" ]] && fzfPreview+=' | bash -c "col -bx | '"${binBatcat}"' --color=always --language=man --paging=never --style=plain"'

	man -k . 2>/dev/null \
		| __fz::fzf --preview="${fzfPreview}" --preview-window="right:70%" --prompt="man > " --query="^$*" --reverse --select-1 \
		| awk '{ gsub( /[ (),]/, " " ) ; print $2, $1 }' \
		| xargs -I {} printf 'man %s\n' {} \
		| bash
}

function fz::ssh()
{
	export -f __fz::fzf

	local fzfPreview="ssh -G -T {} 2>/dev/null | grep -E '^(host|user|hostname|port|identityfile)[[:space:]]' | column -t"
	local sshServer=""

	local arg=""
	local sshArgs=( )
	local remoteCommand=( )
	local isRemoteCommand=false

	for arg in "$@" ; do
		[[ "${arg}" == "--" ]] && isRemoteCommand=true && continue
		[[ "${isRemoteCommand}" == true ]] && remoteCommand+=( "${arg}" ) || sshArgs+=( "${arg}" )
	done

	sshServer=$( bash --noprofile --norc -ic '
		source <( __fz::fzf --bash )
		__fzf_list_hosts | __fz::fzf --height="30%" --preview="'"${fzfPreview}"'" --prompt="ssh > " --reverse --select-1
	' )

	# shellcheck disable=SC2029                     # SC2029: Note that, unescaped, this expands on the client side.
	[[ -z "${sshServer}" ]] || ssh "${sshArgs[@]}" "${sshServer}" "${remoteCommand[@]}"
}

command -v tmux &>/dev/null && function fz::tmux()
{
	local selection=""
	local key=""
	local selectedType=""
	local selectedTarget=""

	selection=$( {
			tmux list-sessions -F "session #S _ #{session_windows}w"
			tmux list-windows -a -F "window #S:#I #W #{window_panes}p"
			tmux list-panes -a -F "pane #S:#I.#P #{pane_current_command}"
		} \
		| column -t \
		| __fz::fzf --expect="enter,ctrl-k" --header=$'\n[ Enter ] ..... attach / switch\n[ CTRL + K ] .. kill\n\n' --prompt="tmux > " --query="$*" --reverse --select-1 --tmux
	)

	key=${selection%%$'\n'*}                        # fzf --expect outputs the key pressed on the first line
	selection=${selection#*$'\n'}                   # remove the key line, leaving the selected process
	selectedType=$( awk '{ print $1 }' <<< "${selection}" )
	selectedTarget=$( awk '{ print $2 }' <<< "${selection}" )

	case "${key}:${selectedType}" in
		enter:session)
			if [[ -n "${TMUX:-}" ]] ; then tmux switch-client -t "${selectedTarget}" ; else tmux attach -t "${selectedTarget}" ; fi ;;

		enter:window)
			if [[ -n "${TMUX:-}" ]] ; then tmux select-window -t "${selectedTarget}" ; else tmux attach -t "${selectedTarget%%:*}" \; select-window -t "${selectedTarget}" ; fi ;;

		enter:pane)
			if [[ -n "${TMUX:-}" ]] ; then tmux select-window -t "${selectedTarget}" \; select-pane -t "${selectedTarget}" ; else tmux attach -t "${selectedTarget%%:*}" \; select-pane -t "${selectedTarget}" ; fi ;;

		ctrl-k:session|ctrl-k:window|ctrl-k:pane)
			__fz::confirm "Kill ?\n\n\tTMUX ${COLOR_CYAN}${selectedType}${COLOR_RESET} ( ${COLOR_CYAN}${selectedTarget}${COLOR_RESET} )" || return 0
			tmux kill-"${selectedType}" -t "${selectedTarget}"
		;;

		:)
			return 0 ;;                             # fzf cancelled
	esac
}

function __fz::commands() { compgen -A function "fz::" | awk '{ sub( /^fz::/, "" ) ; print }' | sort ; }

function __fz::completion::bash()
{
	local commandList=""

	commandList=$( __fz::commands )
	commandList=${commandList//$'\n'/ }

	cat <<- HEREDOC
	_fz_completion() {
		local cur="\${COMP_WORDS[COMP_CWORD]}"
		local prev="\${COMP_WORDS[COMP_CWORD-1]}"
		local commands="-h --help -V --version ${commandList}"

		if [[ \${COMP_CWORD} -eq 1 ]] ; then
			COMPREPLY=( \$( compgen -W "\${commands}" -- "\${cur}" ) )
		elif [[ "\${prev}" == "kill" ]] ; then
			local signals="\$( builtin kill -l | awk '{ for( i = 2 ; i <= NF ; i += 2 ) printf "%s ", \$i }' )"
			COMPREPLY=( \$( compgen -W "\${signals}" -- "\${cur}" ) )
		fi
	}

	complete -F _fz_completion fz
	HEREDOC
}

function __fz::completion::zsh()
{
	local commandList=""

	commandList=$( __fz::commands )

	cat <<- HEREDOC
	#compdef fz

	_fz() {
		local -a commands=( "-h:Show help" "--help:Show help" "-V:Show version" "--version:Show version" )
		local cmd=""

		while IFS= read -r cmd ; do
			commands+=( "\${cmd}:Run fz \${cmd}" )
		done <<- COMMANDS
	${commandList}
	COMMANDS

		if (( CURRENT == 2 )) ; then
			_describe 'command' commands
		elif [[ "\${words[2]}" == "kill" ]] ; then
			local -a signals=( \$( bash -c 'builtin kill -l | awk '\''{ for( i = 2 ; i <= NF ; i += 2 ) printf "%s ", \$i }'\''' ) )
			_describe 'signal' signals
		fi
	}

	compdef _fz fz
	HEREDOC
}

function __fz::confirm()
{
	local msg="${1:-"Proceed?"}"
	local answer=""

	printf -v msg '%b\n\n' "${msg}"

	answer=$( printf '%s\n' 'Yes' 'No' | __fz::fzf --border=rounded --disabled --header="${msg}" --height=10 --no-info --prompt="${FUNCNAME[1]} > " --reverse )
	[[ "${answer}" == "Yes" ]]
}

# treat fzf cancellation (130) as success to avoid triggering pipefail
function __fz::fzf() { fzf "$@" || (( $? == 130 )) ; }

function __fz::help()
{
	local helpFunction=""

	__fz::version

	cat <<- HEREDOC

	Pipe commands to FZF.

	Usage: ${APP_NAME} [COMMAND] [ARGUMENTS]
	       ${APP_NAME} [OPTION]

	Commands:

	$( __fz::commands | awk '{ print "    " $0 }' )

	Command arguments:
	HEREDOC

	while IFS= read -r helpFunction ; do
		printf '\n'
		"${helpFunction}"
	done < <( compgen -A function "__fz::help::" | sort )

	cat <<- HEREDOC

	Options:

	    -h, --help                display this help
	    -V, --version             output version information
	HEREDOC
}

function __fz::help::env()
{
	cat <<- HEREDOC
	    env [QUERY]
	        Filter environment variables.
	        Press <CTRL> + <A> or <CTRL> + <SPACE> to select all filtered results.

	        Example: ${APP_NAME} env PATH
	HEREDOC
}

function __fz::help::kill()
{
	cat <<- HEREDOC
	    kill [SIGNAL]
	        Signal defaults to -SIGTERM; <CTRL> + <K> uses -SIGKILL.

	        Examples:
	            ${APP_NAME} kill
	            ${APP_NAME} kill -9
	HEREDOC
}

function __fz::help::man()
{
	cat <<- HEREDOC
	    man [QUERY]
	        Filter manual pages.

	        Example: ${APP_NAME} man su
	HEREDOC
}

function __fz::help::ssh()
{
	cat <<- HEREDOC
	    ssh [SSH_OPTIONS] [-- COMMAND [ARGUMENTS...]]
	        Arguments before -- are passed to ssh.
	        Arguments after it are executed on the selected host.

	        Examples:
	            ${APP_NAME} ssh -p 2222
	            ${APP_NAME} ssh -p 2222 -- hostname -A
	HEREDOC
}

command -v tmux &>/dev/null && function __fz::help::tmux()
{
	cat <<- HEREDOC
	    tmux [QUERY]
	        Browse tmux sessions, windows and panes.
	        Enter attaches or switches to the selection; <CTRL> + <K> kills it.

	        Example: ${APP_NAME} tmux mySession
	HEREDOC
}

function __fz::main()
{
	local arg="${1:---help}"

	case "${arg}" in
		--bash-completion)
			__fz::completion::bash ;;

		--zsh-completion)
			__fz::completion::zsh ;;

		-h|--help)
			__fz::help ;;

		-V|--version)
			__fz::version ;;

		*)
			command -v fzf &>/dev/null || {
				printf '%s\n' "[${APP_NAME} error]: Install \"fzf\" to use ${APP_NAME}."
				return 1
			}

			declare -F "fz::${arg}" &>/dev/null || {
				printf '%s\n' "[${APP_NAME} error]: Found argument \"${arg}\" which wasn't expected. Try --help."
				return 1
			}

			shift
			fz::"${arg}" "$@"
		;;
	esac

	return $?
}

function __fz::version() { printf '%s\n' "${APP_NAME} ${VERSION}" ; }

__fz::main "$@"
