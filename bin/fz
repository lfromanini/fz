#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail

readonly APP_NAME="${0##*/}"
readonly VERSION="1.14.1"


### commands
##################

### env

function fz::env()
{
	local input=
	local selection=""
	local var=

	input=$(
		env | sort | awk -F= -v c1="${FZ_COLOR_PRIMARY}" -v c2="${FZ_COLOR_SECONDARY}" -v cr="${FZ_COLOR_RESET}" \
			'{ value = substr( $0, length( $1 ) + 2 ) ; gsub( /\033/, "\\E", value ) ; printf "%s%s%s=%s%s\n", c1, $1, c2, cr, value }'
	)

	selection=$( __fz:api::fzf --ansi --bind="ctrl-a:select-all,ctrl-space:select-all" --multi --prompt="env > " --query="$*" --reverse --select-1 <<< "${input}" | cut -d= -f1 )

	while IFS= read -r var ; do
		[[ -z "${var}" ]] || printf "${FZ_COLOR_PRIMARY}%s${FZ_COLOR_SECONDARY}=${FZ_COLOR_RESET}%q\n" "${var}" "${!var}"
	done <<< "${selection}"
}

function __fz::env::fz::help()
{
	cat <<- HEREDOC
	    env [QUERY]
	        Filter environment variables.
	        Press <CTRL> + <A> or <CTRL> + <SPACE> to select all filtered results.

	        Example: ${APP_NAME} env PATH
	HEREDOC
}

### grep

function fz::grep()
{
	local fzfPreview="cat {1}"
	local binSearcher=
	local binBatcat=
	local input=
	local fp=
	local args=( )
	local exclude_dirs=( )

	[[ ${FZ_GREP_EXCLUDE_DIR+x} ]] || FZ_GREP_EXCLUDE_DIR=$( __fz::grep::defaultExcludeDir )

	binSearcher=$( __fz:api::command rg grep )

	case "${binSearcher}" in
		*/rg)
			[[ -n "${FZ_GREP_EXCLUDE_DIR:-}" ]] && args=( "--glob=!{${FZ_GREP_EXCLUDE_DIR}}/" )
			args+=( "--color=always" "--hidden" "--ignore-case" "--line-number" "--with-filename" "$*" "." )
		;;

		*/grep)
			command grep --color=always "" <<< "" &>/dev/null && args=( "--color=always" )

			command grep --exclude-dir="/" "" <<< "" &>/dev/null && {
				IFS=, read -r -a exclude_dirs <<< "${FZ_GREP_EXCLUDE_DIR:-}"

				local dir= ; for dir in "${exclude_dirs[@]}" ; do
					args+=( "--exclude-dir=${dir}" )
				done
			}

			args+=( "-H" "-i" "-n" "-r" "$*" "." )
		;;

		*)
			return 127 ;;
	esac

	binBatcat=$( __fz:api::command batcat bat )
	[[ -n "${binBatcat}" ]] && fzfPreview="${binBatcat} --color=always --highlight-line={2} --style=numbers {1}"

	input=$( "${binSearcher}" "${args[@]}" )
	fp=$( __fz:api::fzf --ansi --delimiter=":" --preview="${fzfPreview}" --prompt="${binSearcher##*/} > " --reverse <<< "${input}" | cut -d: -f1 )

	[[ -z "${fp}" ]] || "${EDITOR:-echo}" "${fp}"
}

function __fz::grep::defaultExcludeDir() { printf '%s' ".git,.venv,__pycache__,node_modules" ; }

function __fz::grep::fz::help()
{
	cat <<- HEREDOC
	    grep [QUERY]
	        Recursively search for text in files using ripgrep (rg) or grep.
	        Press <ENTER> to open the selected file in the editor.

	        Environment:
	            FZ_GREP_EXCLUDE_DIR
	                Comma-separated directory names to exclude from the search.
	                Default: $( __fz::grep::defaultExcludeDir )

	        Example: ${APP_NAME} grep TODO
	HEREDOC
}

### kill

function fz::kill()
{
	local signal=${1:-"-SIGTERM"}
	local cmdProcs="ps aux"
	local fzfHeader=
	local selection=
	local key=
	local pid=

	__fz::kill::isSignal "${signal}" || return $?
	signal=$( tr '[:lower:]' '[:upper:]' <<< "${signal}" )
	[[ "${signal}" == -* ]] || signal="-${signal}"          # make it "-SIGNAL"

	fzfHeader=$'\n[ ENTER ] ..... kill '"${signal}"$'\n[ CTRL + K ] .. force -SIGKILL\n[ CTRL + R ] .. refresh process list\n\n'

	selection=$(
		__fz:api::fzf --bind="ctrl-r:reload( ${cmdProcs} )" --exact --expect="enter,ctrl-k" --header="${fzfHeader}" --header-lines=1 --prompt="kill ${signal} > " --select-1 --tac <<< "$( ${cmdProcs} )"
	)

	key=${selection%%$'\n'*}                                # fzf --expect outputs the key pressed on the first line
	selection=${selection#*$'\n'}                           # remove the key line, leaving the selected process
	pid=$( awk '{ print $2 }' <<< "${selection}" )

	case "${key}" in
		enter) ;;

		ctrl-k)
			__fz:api::confirm "Kill ?\n\n\t${FZ_COLOR_EMPHASIS}SIGKILL${FZ_COLOR_RESET} ( ${FZ_COLOR_EMPHASIS}${selection}${FZ_COLOR_RESET} )" || return 0
			signal="-SIGKILL"
		;;

		*)
			return 0 ;;                                     # fzf cancelled
	esac

	__fz::kill::kill "${signal}" "${pid}"
}

function __fz::kill::fz::completion() {	bash -c "builtin kill -l | awk '{ for ( i = 2 ; i <= NF ; i += 2 ) print \$i }'" ; }

function __fz::kill::fz::help()
{
	cat <<- HEREDOC
	    kill [SIGNAL]
	        Signal defaults to -SIGTERM; <CTRL> + <K> uses -SIGKILL.
	        Use <CTRL> + <R> to refresh the process list.

	        Examples:
	            ${APP_NAME} kill
	            ${APP_NAME} kill -9
	HEREDOC
}

function __fz::kill::isSignal()
{
	local signal=$1

	[[ "${signal}" == --* || "${signal}" == [0-9]* ]] && return 1
	builtin kill -l "${signal#-}" &>/dev/null
}

function __fz::kill::kill()
{
	local signal=$1
	local pid=$2
	local returnCode=0
	local msg=

	msg=$( builtin kill "${signal}" "${pid}" 2>&1 ) || {
		returnCode=$?
		printf 'kill: %s\n' "${msg#*: kill: }" >&2
	}

	return ${returnCode}
}

### man

function fz::man()
{
	# shellcheck disable=SC2016                             # SC2016: Expressions don't expand in single quotes, use double quotes for that.
	local fzfPreview='awk '\''{ gsub( /[ (),]/, " " ) ; print $2, $1 }'\'' <<< {} | xargs man'
	local binBatcat=

	binBatcat=$( __fz:api::command batcat bat )

	[[ -n "${binBatcat}" ]] && fzfPreview+=' | bash -c "col -bx | '"${binBatcat}"' --color=always --language=man --paging=never --style=plain"'

	__fz:api::fzf --preview="${fzfPreview}" --preview-window="right:70%" --prompt="man > " --query="^$*" --reverse --select-1 <<< "$( man -k . 2>/dev/null )" \
		| awk '{ gsub( /[ (),]/, " " ) ; print $2, $1 }' \
		| xargs -I {} printf 'man %s\n' {} \
		| bash
}

function __fz::man::fz::help()
{
	cat <<- HEREDOC
	    man [QUERY]
	        Filter manual pages.

	        Example: ${APP_NAME} man su
	HEREDOC
}

### ssh

function fz::ssh()
{
	export -f __fz:api::fzf

	local fzfFilter=

	IFS= read -r -d '' fzfFilter <<- 'AWK' || :             # use a heredoc to improve readability when building the awk preview command
	awk -v c1="\${FZ_COLOR_MUTED}" -v cr="\${FZ_COLOR_RESET}" 'BEGIN {
		names[\"host\"] = \"Host\"                  # convert directive names to PascalCase
		names[\"user\"] = \"User\"
		names[\"hostname\"] = \"HostName\"
		names[\"port\"] = \"Port\"
		names[\"forwardx11\"] = \"ForwardX11\"
		names[\"permitlocalcommand\"] = \"PermitLocalCommand\"
		names[\"requesttty\"] = \"RequestTTY\"
		names[\"stricthostkeychecking\"] = \"StrictHostKeyChecking\"
		names[\"serveraliveinterval\"] = \"ServerAliveInterval\"
		names[\"localcommand\"] = \"LocalCommand\"
		names[\"remotecommand\"] = \"RemoteCommand\"
		names[\"identityfile\"] = \"IdentityFile\"
		names[\"globalknownhostsfile\"] = \"GlobalKnownHostsFile\"
		names[\"userknownhostsfile\"] = \"UserKnownHostsFile\"
		names[\"forwardagent\"] = \"ForwardAgent\"
		names[\"connecttimeout\"] = \"ConnectTimeout\"
		names[\"proxycommand\"] = \"ProxyCommand\"
		names[\"proxyjump\"] = \"ProxyJump\"

		for( name in names )                        # dynamically build the lookup pattern from the names array
			pattern = pattern ( pattern ? \"|\" : \"\" ) name

		pattern = \"^(\" pattern \")[[:space:]]\"   # ^(host|user|hostname|port|...)[[:space:]]
	}
	\$0 ~ pattern {
		key = names[\$1]
		value = \$0
		sub( /^[^[:space:]]+[[:space:]]+/, \"\", value )
		printf \"%s%-22s%s%s\n\", c1, key, cr, value
	}'
	AWK

	local fzfPreview="ssh -G {} 2>/dev/null | ${fzfFilter}"
	local sshServer=

	local arg=
	local sshArgs=( )
	local remoteCommand=( )
	local isRemoteCommand=false

	for arg in "$@" ; do
		[[ "${arg}" == "--" ]] && isRemoteCommand=true && continue
		[[ "${isRemoteCommand}" == true ]] && remoteCommand+=( "${arg}" ) || sshArgs+=( "${arg}" )
	done

	sshServer=$( bash --noprofile --norc -ic '
		source <( __fz:api::fzf --bash )
		__fzf_list_hosts | __fz:api::fzf --height="30%" --preview="'"${fzfPreview}"'" --preview-window="right:70%" --prompt="ssh > " --reverse --select-1
	' 2>/dev/null )

	# shellcheck disable=SC2029                             # SC2029: Note that, unescaped, this expands on the client side.
	[[ -z "${sshServer}" ]] || ssh "${sshArgs[@]}" "${sshServer}" "${remoteCommand[@]}"
}

function __fz::ssh::fz::help()
{
	cat <<- HEREDOC
	    ssh [SSH_OPTIONS] [-- COMMAND [ARGUMENTS...]]
	        Arguments before -- are passed to ssh.
	        Arguments after it are executed on the selected host.

	        Examples:
	            ${APP_NAME} ssh -p 2222
	            ${APP_NAME} ssh -p 2222 -- hostname -A
	HEREDOC
}

### tmux

command -v tmux &>/dev/null && function fz::tmux()
{
	local selection=
	local key=
	local selectedType=
	local selectedTarget=

	selection=$( {
			tmux list-sessions -F "session #S _ #{session_windows}w"
			tmux list-windows -a -F "window #S:#I #W #{window_panes}p"
			tmux list-panes -a -F "pane #S:#I.#P #{pane_current_command}"
		} \
		| column -t \
		| __fz:api::fzf --expect="enter,ctrl-k" --header=$'\n[ Enter ] ..... attach / switch\n[ CTRL + K ] .. kill\n\n' --prompt="tmux > " --query="$*" --reverse --select-1 --tmux
	)

	key=${selection%%$'\n'*}                                # fzf --expect outputs the key pressed on the first line
	selection=${selection#*$'\n'}                           # remove the key line, leaving the selected process
	selectedType=$( awk '{ print $1 }' <<< "${selection}" )
	selectedTarget=$( awk '{ print $2 }' <<< "${selection}" )

	case "${key}:${selectedType}" in
		enter:session)
			if [[ -n "${TMUX:-}" ]] ; then tmux switch-client -t "${selectedTarget}" ; else tmux attach -t "${selectedTarget}" ; fi ;;

		enter:window)
			if [[ -n "${TMUX:-}" ]] ; then tmux select-window -t "${selectedTarget}" ; else tmux attach -t "${selectedTarget%%:*}" \; select-window -t "${selectedTarget}" ; fi ;;

		enter:pane)
			if [[ -n "${TMUX:-}" ]] ; then tmux select-window -t "${selectedTarget}" \; select-pane -t "${selectedTarget}" ; else tmux attach -t "${selectedTarget%%:*}" \; select-pane -t "${selectedTarget}" ; fi ;;

		ctrl-k:session|ctrl-k:window|ctrl-k:pane)
			__fz:api::confirm "Kill ?\n\n\tTMUX ${FZ_COLOR_EMPHASIS}${selectedType}${FZ_COLOR_RESET} ( ${FZ_COLOR_EMPHASIS}${selectedTarget}${FZ_COLOR_RESET} )" || return 0
			tmux kill-"${selectedType}" -t "${selectedTarget}"
		;;
	esac
}

command -v tmux &>/dev/null && function __fz::tmux::fz::help()
{
	cat <<- HEREDOC
	    tmux [QUERY]
	        Browse tmux sessions, windows and panes.
	        Enter attaches or switches to the selection; <CTRL> + <K> kills it.

	        Example: ${APP_NAME} tmux mySession
	HEREDOC
}

### api functions
##################

function __fz:api::command()
(
	local cmd=

	local cmdSearch= ; for cmdSearch in "$@" ; do
		unalias "${cmdSearch}" &>/dev/null || :
		unset -f "${cmdSearch}" &>/dev/null || :

		cmdSearch=$( command -v "${cmdSearch}" || : )
		[[ -n "${cmdSearch}" ]] && cmd=${cmdSearch} && break
	done

	printf '%s\n' "${cmd}"
)

function __fz:api::confirm()
{
	local msg=${1:-"Proceed?"}
	local answer=

	printf -v msg '%b\n\n' "${msg}"

	answer=$( printf '%s\n' 'Yes' 'No' | __fz:api::fzf --border=rounded --disabled --header="${msg}" --height=10 --no-info --prompt="${FUNCNAME[1]} > " --reverse )
	[[ "${answer}" == "Yes" ]]
}

# treat fzf cancellation (130) as success to avoid triggering pipefail
function __fz:api::fzf() { fzf "$@" || (( $? == 130 )) ; }

### core functions
##################

function __fz:core::commands() { compgen -A function "fz::" | awk '{ sub( /^fz::/, "" ) ; print }' | sort ; }

function _fz:core::completion()
{
	local cmd=${1:-}

	declare -F "fz::${cmd}" &>/dev/null || return 1
	declare -F "__fz::${cmd}::fz::completion" &>/dev/null || return 0

	"__fz::${cmd}::fz::completion"
}

function __fz:core::completion::bash()
{
	local cmdList=

	cmdList=$( __fz:core::commands )
	cmdList=${cmdList//$'\n'/ }

	cat <<- HEREDOC
	_fz_completion() {
		local cur="\${COMP_WORDS[COMP_CWORD]}"
		local command="\${COMP_WORDS[1]}"
		local commands="-h --help -V --version ${cmdList}"

		if [[ \${COMP_CWORD} -eq 1 ]] ; then
			COMPREPLY=( \$( compgen -W "\${commands}" -- "\${cur}" ) )
		else
			local completions="\$( fz _fz:core::completion "\${command}" )"
			COMPREPLY=( \$( compgen -W "\${completions}" -- "\${cur}" ) )
		fi
	}

	complete -F _fz_completion fz
	HEREDOC
}

function __fz:core::completion::zsh()
{
	local cmdList=
	cmdList=$( __fz:core::commands | awk '{ printf "\t\t\"%s:Run fz %s\"\n", $0, $0 }' )

	cat <<- HEREDOC
	#compdef fz

	_fz() {
		local -a commands=(
			"-h:Show help"
			"--help:Show help"
			"-V:Show version"
			"--version:Show version"
	${cmdList}
		)

		if (( CURRENT == 2 )) ; then
			_describe 'command' commands
			return
		fi

		local command="\${words[2]}"
		local -a completions=( \$( fz _fz:core::completion "\${command}" ) )
		_describe 'completion' completions
	}

	compdef _fz fz
	HEREDOC
}

function __fz:core::help()
{
	local cmd=
	local helpFunction=

	__fz:core::version

	cat <<- HEREDOC

	Pipe commands to FZF.

	Usage:
	    ${APP_NAME} [COMMAND] [ARGUMENTS]
	    ${APP_NAME} [OPTION]

	Commands:

	$( __fz:core::commands | awk '{ print "    " $0 }' )

	Command arguments:
	$(
		while IFS= read -r cmd ; do
			helpFunction="__fz::${cmd}::fz::help"
			declare -F "${helpFunction}" &>/dev/null && printf '\n' && "${helpFunction}"
		done < <( __fz:core::commands )
	)

	Options:

	    -h, --help                display this help
	    -V, --version             output version information
	HEREDOC
}

function __fz:core::main()
{
	local arg=${1:-"--help"}
	local binBatcat=

	case "${arg}" in
		--bash-completion)
			__fz:core::completion::bash ;;

		--zsh-completion)
			__fz:core::completion::zsh ;;

		-h|--help)
			binBatcat=$( __fz:api::command batcat bat )

			if [[ -n "${binBatcat}" ]] ; then
				__fz:core::theme
				__fz:core::help 2>&1 | "${binBatcat}" --language=help --paging=never --style=plain
			else
				__fz:core::help
			fi
		;;

		-V|--version)
			__fz:core::version ;;

		_fz:*)
			shift
			"${arg}" "$@"                                   # non-public (internal) functions
		;;

		*)
			__fz:core::theme

			command -v fzf &>/dev/null || {
				printf '[%s]: Install "%s" to use %s.\n' "${FZ_COLOR_ACCENT}${APP_NAME} error${FZ_COLOR_RESET}" "${FZ_COLOR_STRONG}fzf${FZ_COLOR_RESET}" "${APP_NAME}"
				return 127
			}

			declare -F "fz::${arg}" &>/dev/null || {
				printf '[%s]: Found argument "%s" which wasn'\''t expected. Try --help.\n' "${FZ_COLOR_ACCENT}${APP_NAME} error${FZ_COLOR_RESET}" "${FZ_COLOR_STRONG}${arg}${FZ_COLOR_RESET}"
				return 1
			}

			shift
			fz::"${arg}" "$@"
		;;
	esac

	return $?
}

function __fz:core::theme()
{
	# TODO: allow theme change
	__fz:core::theme::dracula
	export FZ_COLOR_RESET=$'\x1b[0m'
}

function __fz:core::theme::catppuccinMocha()
{
    export FZ_COLOR_PRIMARY=$'\x1b[38;2;137;220;235m'       # #89DCEB
    export FZ_COLOR_SECONDARY=$'\x1b[38;2;203;166;247m'     # #CBA6F7
    export FZ_COLOR_ACCENT=$'\x1b[38;2;245;194;231m'        # #F5C2E7
    export FZ_COLOR_EMPHASIS=$'\x1b[38;2;249;226;175m'      # #F9E2AF
    export FZ_COLOR_STRONG=$'\x1b[38;2;205;214;244m'        # #CDD6F4
    export FZ_COLOR_MUTED=$'\x1b[38;2;108;112;134m'         # #6C7086

    export BAT_THEME="Catppuccin Mocha"
    export FZF_DEFAULT_OPTS+=" --color=fg:#CDD6F4,hl:#CBA6F7 --color=fg+:#CDD6F4,hl+:#CBA6F7 --color=info:#F9E2AF,prompt:#A6E3A1,pointer:#F5C2E7 --color=marker:#F5C2E7,spinner:#FAB387,header:#6C7086"
    export RG_COLORS="path:fg:0xcb,0xa6,0xf7:line:fg:0xa6,0xe3,0xa1:column:fg:0xa6,0xe3,0xa1:match:fg:0xf5,0xc2,0xe7"
    export GREP_COLORS="ms=01;38;2;245;194;231:mc=01;38;2;245;194;231:fn=38;2;137;220;235:ln=38;2;203;166;247:bn=38;2;108;112;134:se=38;2;88;91;112"
}

function __fz:core::theme::dracula()
{
	export FZ_COLOR_PRIMARY=$'\x1b[38;2;139;233;253m'       # #8BE9FD
	export FZ_COLOR_SECONDARY=$'\x1b[38;2;189;147;249m'     # #BD93F9
	export FZ_COLOR_ACCENT=$'\x1b[38;2;255;121;198m'        # #FF79C6
	export FZ_COLOR_EMPHASIS=$'\x1b[38;2;241;250;140m'      # #F1FA8C
	export FZ_COLOR_STRONG=$'\x1b[38;2;248;248;242m'        # #F8F8F2
	export FZ_COLOR_MUTED=$'\x1b[38;2;98;114;164m'          # #6272A4

	export BAT_THEME=Dracula
	export FZF_DEFAULT_OPTS+=" --color=fg:#f8f8f2,hl:#bd93f9 --color=fg+:#f8f8f2,hl+:#bd93f9 --color=info:#ffb86c,prompt:#50fa7b,pointer:#ff79c6 --color=marker:#ff79c6,spinner:#ffb86c,header:#6272a4"
	export RG_COLORS="path:fg:0xbd,0x93,0xf9:line:fg:0x50,0xfa,0x7b:column:fg:0x50,0xfa,0x7b:match:fg:0xff,0x55,0x55"
	export GREP_COLORS="ms=01;38;2;255;121;198:mc=01;38;2;255;121;198:fn=38;2;139;233;253:ln=38;2;189;147;249:bn=38;2;98;114;164:se=38;2;68;71;90"
}

function __fz:core::version() { printf '%s %s\n' "${APP_NAME}" "${VERSION}" ; }

__fz:core::main "$@"
