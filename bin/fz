#!/usr/bin/env bash

readonly APP_NAME="${0##*/}"
readonly VERSION="1.3.1"

function fz::env()
{
	local var=""

	var="$( env | sort | awk -F= '{ value = substr( $0, length( $1 ) + 2 ) ; gsub( /\033/, "\\E", value ) ; printf "\033[1;36m%s\033[0m\033[35m=\033[0m%s\n", $1, value }' \
		| fzf --ansi --prompt="env > " --reverse --select-1 \
		| cut -d= -f1 \
	)"

	[[ -z "${var}" ]] || printf "\033[1;36m%s\033[0m\033[35m=\033[0m\033[2m%q\033[0m\n" "${var}" "${!var}"
}

function fz::kill()
{
	local signal="${1:--SIGTERM}"

	[[ "${signal}" == -* ]] || signal="-${signal}"
	ps aux | fzf --exact --header-lines=1 --prompt="kill ${signal} > " --select-1 --tac | awk '{ print $2 }' | xargs -I {} kill "${signal}" {}
}

function fz::man()
{
	# shellcheck disable=SC2016     # SC2016: Expressions don't expand in single quotes, use double quotes for that.
	local fzfPreview='awk '\''{ gsub( /[ (),]/, " " ) ; print $2, $1 }'\'' <<< {} | xargs man'
	local binBatcat=""

	binBatcat="$( command -v batcat || command -v bat )"

	[[ -n "${binBatcat}" ]] && \
		fzfPreview+=' | sh -c "col -bx | '"${binBatcat}"' --color=always --language=man --paging=never --style=plain"'

	man -k . 2>/dev/null \
		| fzf --preview="${fzfPreview}" --preview-window="right:70%" --prompt="man > " --query="^${*}" --reverse --select-1 \
		| awk '{ gsub( /[ (),]/, " " ) ; print $2, $1 }' \
		| xargs -I {} printf "man %s\n" {} \
		| sh
}

function fz::ssh()
{
	local fzfPreview="ssh -G -T {} 2>/dev/null | grep -E '^(host|user|hostname|port|identityfile)[[:space:]]' | column -t"
	local sshServer=""

	sshServer="$( bash --noprofile --norc -ic '
		source <( fzf --bash )
		__fzf_list_hosts | fzf --height=30% --preview="'"${fzfPreview}"'" --prompt="ssh > " --reverse --select-1
	' )"

	# shellcheck disable=SC2029     # SC2029: Note that, unescaped, this expands on the client side.
	[[ -z "${sshServer}" ]] || ssh "${@}" "${sshServer}"
}

command -v tmux &>/dev/null && function fz::tmux()
{
	local selection=""
	local key=""
	local selectedType=""
	local selectedTarget=""

	selection="$( {
			tmux list-sessions -F "session #S _ #{session_windows}w"
			tmux list-windows -a -F "window #S:#I #W #{window_panes}p"
			tmux list-panes -a -F "pane #S:#I.#P #{pane_current_command}"
		} \
		| column -t \
		| fzf --expect="enter,ctrl-k" --header=$'\n[ Enter ] ..... attach / switch\n[ Ctrl + k ] .. kill\n\n' --prompt="tmux > " --reverse --select-1 --tmux \
		| xargs printf "%q "
	)"

	[[ -z "${selection}" ]] && return 0

	key="$( awk '{ print $1 }' <<< "${selection}" )"
	selectedType="$( awk '{ print $2 }' <<< "${selection}" )"
	selectedTarget="$( awk '{ print $3 }' <<< "${selection}" )"

	if [[ "${key}" == "enter" ]] ; then

		case "${selectedType}" in
			session) if [[ -n "${TMUX}" ]] ; then tmux switch-client -t "${selectedTarget}" ; else tmux attach -t "${selectedTarget}" ; fi ;;
			window) if [[ -n "${TMUX}" ]] ; then tmux select-window -t "${selectedTarget}" ; else tmux attach -t "${selectedTarget%%:*}" \; select-window -t "${selectedTarget}" ; fi ;;
			pane) if [[ -n "${TMUX}" ]] ; then tmux select-window -t "${selectedTarget}" \; select-pane -t "${selectedTarget}" ; else tmux attach -t "${selectedTarget%%:*}" \; select-pane -t "${selectedTarget}" ; fi ;;
		esac

	elif [[ "${key}" == "ctrl-k" ]] ; then

		case "${selectedType}" in
			session) tmux kill-session -t "${selectedTarget}" ;;
			window) tmux kill-window -t "${selectedTarget}" ;;
			pane) tmux kill-pane -t "${selectedTarget}" ;;
		esac
	fi
}

function __fz::completion::bash()
{
	cat <<- 'HEREDOC'
	_fz_completion() {
		local cur="${COMP_WORDS[COMP_CWORD]}"
		local prev="${COMP_WORDS[COMP_CWORD-1]}"

		local commands="-h --help -V --version"

		commands+="$( fz --help | awk '/^Commands:/{ f = 1 ; next }/^Options:/{ f = 0 } f && NF { printf " %s", $1 }' )"

		if [[ ${COMP_CWORD} -eq 1 ]] ; then
			COMPREPLY=( $( compgen -W "${commands}" -- "${cur}" ) )
		elif [[ "${prev}" == "kill" ]] ; then
			local signals="$( kill -l | awk '{ for( i = 2 ; i <= NF ; i += 2 ) printf "%s ", $i }' )"
			COMPREPLY=( $( compgen -W "${signals}" -- "${cur}" ) )
		fi
	}

	complete -F _fz_completion fz
	HEREDOC
}

function __fz::completion::zsh()
{
	cat <<- 'HEREDOC'
	#compdef fz

	_fz() {
		local -a commands=( "-h:Show help" "--help:Show help" "-V:Show version" "--version:Show version" )
		local cmd=""

		while IFS= read -r cmd ; do
			commands+=( "${cmd}:Run fz ${cmd}" )
		done < <( fz --help | awk '/^Commands:/{ f = 1 ; next }/^Options:/{ f = 0 } f && NF { print $1 }' )

		if (( CURRENT == 2 )) ; then
			_describe 'command' commands
		elif [[ "${words[2]}" == "kill" ]] ; then
			local -a signals=( ${(f)"$( kill -l | awk '{ for( i = 1 ; i <= NF ; i++ ) print "SIG" $i }' )"} )
			_describe 'signal' signals
		fi
	}

	compdef _fz fz
	HEREDOC
}

function __fz::help()
{
	__fz::version

	cat <<- HEREDOC

	Pipe commands to FZF.

	Usage: ${APP_NAME} [COMMAND] [arguments for COMMAND]
	       ${APP_NAME} [OPTION]

	Commands:

	$( compgen -A function "fz::" | awk '{ sub( /^fz::/, "    " ) ; print }' )

	Options:

	    -h, --help                display this help
	    -V, --version             output version information
	HEREDOC
}

function __fz::version() { printf "%s\n" "${APP_NAME} ${VERSION}" ; }

function __fz::main()
{
	local arg="${1:---help}"

	case "${arg}" in
		--bash-completion)
			__fz::completion::bash
			return 0
		;;

		--zsh-completion)
			__fz::completion::zsh
			return 0
		;;

		-h|--help)
			__fz::help
			return 0
		;;

		-V|--version)
			__fz::version
			return 0
		;;

		*)
			command -v fzf &>/dev/null || {
				printf "%s\n" "[${APP_NAME} error]: Install \"fzf\" to use ${APP_NAME}."
				return 1
			}

			[[ "$( type -t "fz::${arg}" )" == "function" ]] || {
				printf "%s\n" "[${APP_NAME} error]: Found argument \"${arg}\" which wasn't expected. Try --help."
				return 1
			}

			shift
			fz::"${arg}" "${@}"
			return "${?}"
		;;
	esac
}

__fz::main "${@}"
