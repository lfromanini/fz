#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail

readonly APP_NAME=${0##*/}
readonly VERSION=1.17.4

### commands
##################

### env

function fz::env()
{
	local fzfHeader=$'\n[ TAB ] ........................... select / deselect\n[ CTRL + A ] / [ CTRL + SPACE ] ... select all\n\n'
	local idx=
	local input=
	local selection=

	input=$( for idx in "${!__FZ_ENV_SNAPSHOT[@]}" ; do printf "${FZ_COLOR_PRIMARY}%s${FZ_COLOR_SECONDARY}=${FZ_COLOR_RESET}%q\n" "${idx}" "${__FZ_ENV_SNAPSHOT[${idx}]}" ; done | sort )
	selection=$( fz:api::fzf --accept-nth=1 --ansi --bind=ctrl-a:select-all,ctrl-space:select-all --delimiter="=" --header="${fzfHeader}" --multi --prompt="${FUNCNAME[0]} > " --query="$*" --reverse <<< "${input}" )

	while IFS= read -r idx ; do
		[[ -z ${idx} ]] || printf "${FZ_COLOR_PRIMARY}%s${FZ_COLOR_SECONDARY}=${FZ_COLOR_RESET}%q\n" "${idx}" "${!idx}"
	done <<< "${selection}"
}

function fz::env::fz::hook::onInit()
{
	declare -gA __FZ_ENV_SNAPSHOT=( )
	local idx=

	while IFS= read -r idx ; do
		__FZ_ENV_SNAPSHOT["${idx}"]=${!idx}
	done < <( compgen -e )
}

function public:fz::env::fz::help()
{
	cat <<- HEREDOC
	    env [QUERY]
	        Filter environment variables.
	        Press <TAB> to select multiple items.
	        Press <CTRL> + <A> or <CTRL> + <SPACE> to select all filtered results.

	        Example: ${APP_NAME} env PATH
	HEREDOC
}

### git

function fz::git()
{
	local arg=

	git rev-parse --is-inside-work-tree &>/dev/null || {
		local returnCode=$?

		printf '[%s]: %s: not a git repository (or any parent up to mount point /)\n' \
			"${FZ_COLOR_ACCENT}${APP_NAME} error${FZ_COLOR_RESET}" \
			"${FZ_COLOR_STRONG}${FUNCNAME[0]}${FZ_COLOR_RESET}"

		return ${returnCode}
	}

	arg=$( fz:api::fzf --height=30% --prompt="${FUNCNAME[0]} > " --query="${1:-}" --reverse --select-1 <<< "$( public:fz::git::fz::completion )" )

	[[ -z ${arg} ]] || {

		[[ -n ${1:-} ]] && shift
		fz::git::"${arg}" "$@"
	}
}

function fz::git::add()
{
	local cmdPreview="nl -ba"
	local fzfHeader=$'\n[ TAB ] ........................... select / deselect\n\n'
	local fzfPreview=
	local binBatcat=
	local input=
	local selection=

	binBatcat=$( fz:api::command batcat bat )
	[[ -n ${binBatcat} ]] && cmdPreview="${binBatcat} --color=always --style=numbers --terminal-width=\${FZF_PREVIEW_COLUMNS}"

	fzfPreview="
		fp=\$( awk '{ print substr( \$0, 4 ) }' <<< {} )
		[[ -n \${fp} ]] || return 0
		if git ls-files --error-unmatch -- \"\${fp}\" &>/dev/null ; then git diff --color=always HEAD -- \"\${fp}\" | $( fz::git::getPager ) ; else ${cmdPreview} -- \"\${fp}\" ; fi
	"

	input=$( GIT_CONFIG_PARAMETERS="'color.status=always'" git status --null --short --untracked-files=all | xargs -0 -n 1 )
	selection=$( fz:api::fzf --ansi --header="${fzfHeader}" --multi --preview="${fzfPreview}" --preview-window=right:70% --prompt="${FUNCNAME[0]} > " --query="$*" --reverse <<< "${input}" )

	[[ -z ${selection} ]] || {
		while IFS= read -r input ; do
			input=${input:3}
			[[ -z ${input} ]] || git add -- "${input}"
		done <<< "${selection}"

		git diff --cached --quiet || git status
	}
}

function fz::git::branch()
{
	local fzfHeader=$'\n[ ENTER ] ......................... switch to branch\n[ CTRL + D ] ...................... delete selected branch\n[ CTRL + N ] ...................... create a new branch from selected branch\n\n'
	local fzfPreview=
	local input=
	local key=
	local selection=

	input=$( git for-each-ref --format='%(refname:short)%09%(objectname:short)%09%(committerdate:relative)%09%(refname)%09%(symref)' --sort=-committerdate refs/heads refs/remotes | awk -F '\t' '
		$5 == "" {
			count++

			if( length( $1 ) > max )
				max = length( $1 )

			rows[count] = $1 "\t" $2 "\t" $3 "\t" $4
		}

		END {
			for( i = 1 ; i <= count ; i++ ) {
				split( rows[i], fields, "\t" )
				printf "%-*s  %-10s  %-20s\t%s\n", max, fields[1], fields[2], fields[3], fields[4]
			}
		}
	' )

	fzfPreview="grep -oE 'refs/(heads|remotes)/[^[:space:]]+' <<< {} | xargs git log --color=always --decorate --graph --max-count=100 --oneline | $( fz::git::getPager )"

	selection=$( fz:api::fzf --delimiter=$'\t' --expect=ctrl-d,ctrl-n,enter --header="${fzfHeader}" --preview="${fzfPreview}" --prompt="${FUNCNAME[0]} > " --query="$*" --reverse <<< "${input}" )

	key=${selection%%$'\n'*}                                # extract the key pressed in fzf
	selection=${selection#*$'\n'}                           # remove the key from the selection output
	selection=${selection##*$'\t'}                          # extract the Git reference from the selected row

	[[ -z ${selection} ]] && return 0

	case ${key} in
		ctrl-d)
			fz::git::branch::delete "${selection}" ;;

		ctrl-n)
			fz::git::branch::new "${selection}" ;;

		enter)
			fz::git::branch::switch "${selection}" ;;
	esac
}

function fz::git::branch::delete()
{
	local ref=$1
	local branchName=${ref#refs/heads/}

	case ${ref} in
		refs/heads/*)
			fz:api::confirm "Delete local branch ?\n\n\t${FZ_COLOR_EMPHASIS}${branchName}${FZ_COLOR_RESET}" || return 0
			git branch --delete -- "${branchName}"
		;;

		refs/remotes/*)
			local remote=${branchName#*/}
			local remoteName=${branchName%%/*}

			fz:api::confirm "Delete remote branch ?\n\n\t${FZ_COLOR_EMPHASIS}${remoteName}/${remote}${FZ_COLOR_RESET}" || return 0
			git push "${remoteName}" --delete "${remote}"
		;;
	esac
}

function fz::git::branch::new()
{
	local ref=$1
	local branchName=${ref##*/}
	local baseBranch=${ref#refs/heads/}
	baseBranch=${baseBranch#refs/remotes/}

	branchName=$( fz:api::fzf --header="Create new branch from [${FZ_COLOR_EMPHASIS}${baseBranch}${FZ_COLOR_RESET}]" --phony --print-query --prompt="${FUNCNAME[0]} > " --query="${branchName}" --reverse <<< "" )
	branchName=${branchName%%$'\n'*}

	[[ -z ${branchName} ]] || {
		git check-ref-format --branch "${branchName}" >/dev/null || return $?
		git switch --create "${branchName}" -- "${ref}"
	}
}

function fz::git::branch::switch()
{
	local ref=$1

	case ${ref} in
		refs/heads/*)
			git switch -- "${ref#refs/heads/}"
		;;

		refs/remotes/*)
			local remoteBranch=${ref#refs/remotes/}
			local localBranch=${remoteBranch#*/}

			if git show-ref --quiet --verify "refs/heads/${localBranch}" ; then git switch -- "${localBranch}" ; else fz::git::branch::new "${ref}" ; fi
		;;
	esac
}

function fz::git::diff()
{
	local fzfPreview=
	local input=
	local selection=

	fzfPreview="[[ -z {2} ]] || git diff HEAD -- {2} | $( fz::git::getPager )"

	input=$( git diff --color=always --name-status HEAD )
	selection=$( fz:api::fzf --accept-nth=2 --ansi --preview="${fzfPreview}" --preview-window=right:70% --prompt="${FUNCNAME[0]} > " --query="$*" --reverse <<< "${input}" )

	[[ -z "${selection}" ]] || git diff HEAD -- "${selection}"
}

function fz::git::getPager()
{
	local pager=
	pager=$( git config --get core.pager || : )

	case $( basename -- "${pager%% *}" ) in                 # extract the executable name from the pager command
		delta|difft)
			pager="${pager} --width=\${FZF_PREVIEW_COLUMNS}"
		;;

		batcat|bat)
			pager="awk 'NR == 1 { print substr( \$3, 3 ) ; exit }' | xargs ${pager} --color=always --terminal-width=\${FZF_PREVIEW_COLUMNS}"
			[[ " ${pager} " =~ [[:space:]]--diff([[:space:]]|$) ]] || pager="${pager} --diff"
		;;

		*)
			pager="COLUMNS=\${FZF_PREVIEW_COLUMNS} ${pager:-cat}"
		;;
	esac

	printf '%s' "${pager}"
}

function fz::git::log()
{
	function __hashFilter() { awk '{ gsub( /\033\[[0-9;]*m/, "" ) } match( $0, /[0-9a-f]{7,}/ ) { print substr( $0, RSTART, RLENGTH ) ; exit }' ; }
	export -f __hashFilter

	local fzfPreview="bash --noprofile --norc -c __hashFilter <<< {} | xargs git show --color=always --format=fuller --stat"
	local input=
	local hash=

	input=$( git log --color=always --format="%C(auto)%h%d %s %C(black)%C(bold)%cr%Creset" --graph )
	hash=$( fz:api::fzf --ansi --preview="${fzfPreview}" --prompt="${FUNCNAME[0]} > " --query="$*" --reverse <<< "${input}" | __hashFilter )

	[[ -z ${hash} ]] || git show --color=always "${hash}"
}

function public:fz::git::fz::completion() { printf '%s\n' add branch diff log ; }

function public:fz::git::fz::help()
{
	cat <<- HEREDOC
	    git [COMMAND] [QUERY]
	        Browse Git files, branches, diffs and commits.

	        Commands:
	            add               select files to stage (multiple selection with <TAB>)
	            branch            browse, switch, create (<CTRL> + <N>) or delete (<CTRL> + <D>) branches
	            diff              browse changed files and inspect their diffs
	            log               browse commits and inspect their details

	        Examples:
	            ${APP_NAME} git add
	            ${APP_NAME} git branch
	            ${APP_NAME} git diff
	            ${APP_NAME} git log
	HEREDOC
}

### grep

function fz::grep()
{
	local fzfPreview="nl -ba {1}"
	local binSearcher=
	local binBatcat=
	local input=
	local fp=
	local args=( )

	[[ -v FZ_GREP_EXCLUDE_DIR ]] || FZ_GREP_EXCLUDE_DIR=$( fz::grep::defaultExcludeDir )

	binSearcher=$( fz:api::command rg grep )

	case ${binSearcher} in
		*/rg)
			[[ -n ${FZ_GREP_EXCLUDE_DIR:-} ]] && args+=( --glob="!{${FZ_GREP_EXCLUDE_DIR}}/" )
			# shellcheck disable=SC2206                     # SC2206: Quote to prevent word splitting/globbing, or split robustly with mapfile or `read -a`.
			args+=( --color=always ${FZ_RIPGREP_COLORS} --hidden --ignore-case --line-number --with-filename "$*" . )
		;;

		*/grep)
			command grep --color=always "" <<< "" &>/dev/null && args+=( --color=always )

			command grep --exclude-dir="/" "" <<< "" &>/dev/null && {
				local excludeDirs=( )

				IFS=, read -r -a excludeDirs <<< "${FZ_GREP_EXCLUDE_DIR:-}"

				local dir= ; for dir in "${excludeDirs[@]}" ; do
					args+=( --exclude-dir="${dir}" )
				done
			}

			args+=( -H -i -n -r "$*" . )
		;;

		*)
			return 127 ;;
	esac

	binBatcat=$( fz:api::command batcat bat )
	[[ -n ${binBatcat} ]] && fzfPreview="${binBatcat} --color=always --highlight-line={2} --style=numbers --terminal-width=\${FZF_PREVIEW_COLUMNS} {1}"

	input=$( ${binSearcher} "${args[@]}" )
	fp=$( fz:api::fzf --accept-nth=1 --ansi --delimiter=":" --preview="${fzfPreview}" --prompt="${FUNCNAME[0]} ( ${binSearcher##*/} ) > " --reverse <<< "${input}" )

	if [[ -z ${fp} ]] ; then return 0 ; elif [[ -n ${EDITOR:-} ]] ; then ${EDITOR} -- "${fp}" ; else printf '%s\n' "${fp}" ; fi
}

function fz::grep::defaultExcludeDir() { printf ".git,.venv,__pycache__,node_modules" ; }

function public:fz::grep::fz::help()
{
	cat <<- HEREDOC
	    grep [QUERY]
	        Recursively search for text in files using ripgrep (rg) or grep.
	        Press <ENTER> to open the selected file in the editor.

	        Environment:
	            FZ_GREP_EXCLUDE_DIR
	                Comma-separated directory names to exclude from the search.
	                Default: $( fz::grep::defaultExcludeDir )

	        Example: ${APP_NAME} grep TODO
	HEREDOC
}

### kill

function fz::kill()
{
	local signal=${1:-"-SIGTERM"}
	local cmdProcs="ps aux"
	local fzfHeader=
	local selection=
	local key=
	local pid=

	fz::kill::isSignal "${signal}" || {
		local returnCode=$?

		printf '[%s]: Invalid %s signal "%s". Supported signals:\n\n%s\n' \
			"${FZ_COLOR_ACCENT}${APP_NAME} error${FZ_COLOR_RESET}" \
			"${FZ_COLOR_STRONG}${FUNCNAME[0]}${FZ_COLOR_RESET}" \
			"${FZ_COLOR_STRONG}${signal}${FZ_COLOR_RESET}" \
			"${FZ_COLOR_MUTED}$( bash -c "builtin kill -l" )${FZ_COLOR_RESET}"

		return ${returnCode}
	}

	signal=${signal^^}
	[[ ${signal} == -* ]] || signal=-${signal}              # make it "-SIGNAL"

	fzfHeader=$'\n[ ENTER ] ......................... kill '${signal}$'\n[ CTRL + K ] ...................... kill -SIGKILL\n[ CTRL + R ] ...................... refresh process list\n\n'

	selection=$(
		fz:api::fzf --bind="ctrl-r:reload( ${cmdProcs} )" --exact --expect=enter,ctrl-k --header="${fzfHeader}" --header-lines=1 --prompt="${FUNCNAME[0]} ${signal} > " --select-1 --tac <<< "$( ${cmdProcs} )"
	)

	key=${selection%%$'\n'*}                                # fzf --expect outputs the key pressed on the first line
	selection=${selection#*$'\n'}                           # remove the key line, leaving the selected process
	pid=$( awk '{ print $2 }' <<< "${selection}" )

	case ${key} in
		enter) ;;

		ctrl-k)
			fz:api::confirm "Kill ?\n\n\t${FZ_COLOR_EMPHASIS}SIGKILL${FZ_COLOR_RESET} ( ${FZ_COLOR_EMPHASIS}${selection}${FZ_COLOR_RESET} )" || return 0
			signal=-SIGKILL
		;;

		*)
			return 0 ;;                                     # fzf cancelled
	esac

	fz::kill::kill "${signal}" "${pid}"
}

function fz::kill::isSignal()
{
	local signal=$1

	[[ ${signal} == --* || ${signal} == [0-9]* ]] && return 1
	builtin kill -l "${signal#-}" &>/dev/null
}

function fz::kill::kill()
{
	local signal=$1
	local pid=$2
	local returnCode=0
	local msg=

	msg=$( builtin kill "${signal}" "${pid}" 2>&1 ) || {
		returnCode=$?
		printf 'kill: %s\n' "${msg#*: kill: }" >&2
	}

	return ${returnCode}
}

function public:fz::kill::fz::completion() { bash -c "builtin kill -l | awk '{ for ( i = 2 ; i <= NF ; i += 2 ) print \$i }'" ; }

function public:fz::kill::fz::help()
{
	cat <<- HEREDOC
	    kill [SIGNAL]
	        Signal defaults to -SIGTERM; <CTRL> + <K> uses -SIGKILL.
	        Use <CTRL> + <R> to refresh the process list.

	        Examples:
	            ${APP_NAME} kill
	            ${APP_NAME} kill -9
	HEREDOC
}

### man

function fz::man()
{
	local fzfPreview="awk '{ gsub( /[ (),]/, \" \" ) ; print \$2, \$1 }' <<< {} | xargs man"
	local binBatcat=

	binBatcat=$( fz:api::command batcat bat )
	[[ -n ${binBatcat} ]] && fzfPreview+=" | bash -c \"col -bx | ${binBatcat} --color=always --language=man --paging=never --style=plain --terminal-width=\${FZF_PREVIEW_COLUMNS}\""

	fz:api::fzf --preview="${fzfPreview}" --preview-window=right:70% --prompt="${FUNCNAME[0]} > " --query="^$*" --reverse --select-1 <<< "$( man -k . 2>/dev/null )" \
		| awk '{ gsub( /[ (),]/, " " ) ; print $2, $1 }' \
		| xargs -I {} printf 'man %s\n' {} \
		| bash
}

function public:fz::man::fz::help()
{
	cat <<- HEREDOC
	    man [QUERY]
	        Filter manual pages.

	        Example: ${APP_NAME} man su
	HEREDOC
}

### ssh

function fz::ssh()
{
	export -f fz:api::fzf

	local fzfFilter=
	local fzfPreview=
	local sshServer=

	local fzfQuery=
	local sshArgs=( )
	local remoteCommand=( )
	local expectValue=false
	local isRemoteCommand=false

	local arg= ; for arg in "$@" ; do

		[[ ${arg} == -- && ${isRemoteCommand} == false ]] && {
			isRemoteCommand=true
			continue
		}

		[[ ${isRemoteCommand} == true ]] && {
			remoteCommand+=( "${arg}" )
			continue
		}

		[[ ${expectValue} == true ]] && {
			sshArgs+=( "${arg}" )
			expectValue=false
			continue
		}

		[[ ${arg} == -* ]] && {

			sshArgs+=( "${arg}" )
			[[ ${arg} =~ ^-[BbcDEeFIiJLlmOoPpQRSWw]$ ]] && expectValue=true
			continue
		}

		fzfQuery+="${fzfQuery:+ }${arg}"                    # append the argument to the query, adding a space when needed
	done

	IFS= read -r -d '' fzfFilter <<- 'AWK' || :             # use a heredoc to improve readability when building the awk preview command
	awk -v c1="\${FZ_COLOR_MUTED}" -v cr="\${FZ_COLOR_RESET}" 'BEGIN {
		names[\"host\"] = \"Host\"                          # convert directive names to PascalCase
		names[\"user\"] = \"User\"
		names[\"hostname\"] = \"HostName\"
		names[\"port\"] = \"Port\"
		names[\"forwardx11\"] = \"ForwardX11\"
		names[\"permitlocalcommand\"] = \"PermitLocalCommand\"
		names[\"requesttty\"] = \"RequestTTY\"
		names[\"stricthostkeychecking\"] = \"StrictHostKeyChecking\"
		names[\"serveraliveinterval\"] = \"ServerAliveInterval\"
		names[\"localcommand\"] = \"LocalCommand\"
		names[\"remotecommand\"] = \"RemoteCommand\"
		names[\"identityfile\"] = \"IdentityFile\"
		names[\"globalknownhostsfile\"] = \"GlobalKnownHostsFile\"
		names[\"userknownhostsfile\"] = \"UserKnownHostsFile\"
		names[\"forwardagent\"] = \"ForwardAgent\"
		names[\"connecttimeout\"] = \"ConnectTimeout\"
		names[\"proxycommand\"] = \"ProxyCommand\"
		names[\"proxyjump\"] = \"ProxyJump\"

		for( name in names )                                # dynamically build the lookup pattern from the names array
			pattern = pattern ( pattern ? \"|\" : \"\" ) name

		pattern = \"^(\" pattern \")[[:space:]]\"           # ^(host|user|hostname|port|...)[[:space:]]
	}
	\$0 ~ pattern {
		key = names[\$1]
		value = \$0
		sub( /^[^[:space:]]+[[:space:]]+/, \"\", value )
		printf \"%s%-22s%s%s\n\", c1, key, cr, value
	}'
	AWK

	fzfPreview="ssh -G {} 2>/dev/null | ${fzfFilter}"

	sshServer=$( bash --noprofile --norc -ic '
		source <( fz:api::fzf --bash )
		__fzf_list_hosts | fz:api::fzf --height=30% --preview="'"${fzfPreview}"'" --preview-window=right:70% --prompt="'"${FUNCNAME[0]}"' > " --query="'"${fzfQuery}"'" --reverse --select-1
	' 2>/dev/null )

	[[ -z ${sshServer} ]] || ssh "${sshArgs[@]}" "${sshServer}" -- "${remoteCommand[@]}"
}

function public:fz::ssh::fz::help()
{
	cat <<- HEREDOC
	    ssh [SSH_OPTIONS] [-- COMMAND [ARGUMENTS...]]
	        Arguments before -- are passed to ssh.
	        Arguments after it are executed on the selected host.

	        Examples:
	            ${APP_NAME} ssh -p 2222
	            ${APP_NAME} ssh -p 2222 -- hostname -A
	HEREDOC
}

### tmux

function fz::tmux()
{
	local selection=
	local key=
	local selectedType=
	local selectedTarget=

	selection=$( {
			tmux list-sessions -F "session #S _ #{session_windows}w"
			tmux list-windows -a -F "window #S:#I #W #{window_panes}p"
			tmux list-panes -a -F "pane #S:#I.#P #{pane_current_command}"
		} \
		| column -t \
		| fz:api::fzf --expect=enter,ctrl-k --header=$'\n[ Enter ] ..... attach / switch\n[ CTRL + K ] .. kill\n\n' --prompt="${FUNCNAME[0]} > " --query="$*" --reverse --select-1 --tmux
	)

	key=${selection%%$'\n'*}                                # fzf --expect outputs the key pressed on the first line
	selection=${selection#*$'\n'}                           # remove the key line, leaving the selected process
	selectedType=$( awk '{ print $1 }' <<< "${selection}" )
	selectedTarget=$( awk '{ print $2 }' <<< "${selection}" )

	case ${key}:${selectedType} in
		enter:session)
			if [[ -n "${TMUX:-}" ]] ; then tmux switch-client -t "${selectedTarget}" ; else tmux attach -t "${selectedTarget}" ; fi ;;

		enter:window)
			if [[ -n "${TMUX:-}" ]] ; then tmux select-window -t "${selectedTarget}" ; else tmux attach -t "${selectedTarget%%:*}" \; select-window -t "${selectedTarget}" ; fi ;;

		enter:pane)
			if [[ -n "${TMUX:-}" ]] ; then tmux select-window -t "${selectedTarget}" \; select-pane -t "${selectedTarget}" ; else tmux attach -t "${selectedTarget%%:*}" \; select-pane -t "${selectedTarget}" ; fi ;;

		ctrl-k:session|ctrl-k:window|ctrl-k:pane)
			fz:api::confirm "Kill ?\n\n\tTMUX ${FZ_COLOR_EMPHASIS}${selectedType}${FZ_COLOR_RESET} ( ${FZ_COLOR_EMPHASIS}${selectedTarget}${FZ_COLOR_RESET} )" || return 0
			tmux kill-"${selectedType}" -t "${selectedTarget}"
		;;
	esac
}

function public:fz::tmux::fz::help()
{
	cat <<- HEREDOC
	    tmux [QUERY]
	        Browse tmux sessions, windows and panes.
	        Enter attaches or switches to the selection; <CTRL> + <K> kills it.

	        Example: ${APP_NAME} tmux mySession
	HEREDOC
}

### api functions
##################

function fz:api::command()
(
	local cmd=

	local cmdSearch= ; for cmdSearch in "$@" ; do
		unalias "${cmdSearch}" &>/dev/null || :
		unset -f "${cmdSearch}"

		cmdSearch=$( command -v "${cmdSearch}" || : )
		[[ -n ${cmdSearch} ]] && cmd=${cmdSearch} && break
	done

	printf '%s\n' "${cmd}"
)

function fz:api::confirm()
{
	local msg=${1:-"Proceed?"}
	local answer=

	printf -v msg '%b\n\n' "${msg}"

	answer=$( printf '%s\n' 'Yes' 'No' | fz:api::fzf --border=rounded --disabled --header="${msg}" --height=10 --no-info --prompt="${FUNCNAME[1]} > " --reverse )
	[[ ${answer} == Yes ]]
}

function fz:api::fzf()
{
	# treat fzf cancellation (130) as success to avoid triggering pipefail
	fzf "$@" || {
		local returnCode=$?
		(( returnCode == 130 )) || return ${returnCode}
	}
}

### core functions
##################

function fz:core::check()
{
	local -r MIN_VERSION_BASH=4.3
	local -r MIN_VERSION_FZF=0.60

	local fzfVersion=

	fz:core::check::gte "${BASH_VERSION}" "${MIN_VERSION_BASH}" || {
		local returnCode=$?

		printf '[%s]: Bash %s or newer is required (current: %s)\n' "${APP_NAME} error" "${MIN_VERSION_BASH}" "${BASH_VERSION}" >&2
		return ${returnCode}
	}

	command -v fzf &>/dev/null || {
		fz:core::theme
		printf '[%s]: Install "%s" to use %s.\n' "${FZ_COLOR_ACCENT}${APP_NAME} error${FZ_COLOR_RESET}" "${FZ_COLOR_STRONG}fzf${FZ_COLOR_RESET}" "${APP_NAME}" >&2

		return 127
	}

	fzfVersion=$( fzf --version 2>/dev/null )
	fzfVersion=${fzfVersion%% *}

	fz:core::check::gte "${fzfVersion}" "${MIN_VERSION_FZF}" || {
		local returnCode=$?

		fz:core::theme
		printf '[%s]: fzf %s or newer is required (current: %s).\n' "${FZ_COLOR_ACCENT}${APP_NAME} error${FZ_COLOR_RESET}" "${FZ_COLOR_STRONG}${MIN_VERSION_FZF}${FZ_COLOR_RESET}" "${fzfVersion}" >&2
		return ${returnCode}
	}
}

function fz:core::check::gte()
{
	# compare major.minor versions (0: current >= minimum, 1: lower, 2: invalid)
	local currentMajor=
	local currentMinor=
	local minimalMajor=
	local minimalMinor=

	IFS=. read -r currentMajor currentMinor _ <<< "${1#[vV]}"
	IFS=. read -r minimalMajor minimalMinor _ <<< "${2#[vV]}"

	[[ ${currentMajor} =~ ^[0-9]+$ && ${currentMinor} =~ ^[0-9]+$ && ${minimalMajor} =~ ^[0-9]+$ && ${minimalMinor} =~ ^[0-9]+$ ]] || return 2

	(( 10#${currentMajor} < 10#${minimalMajor} )) && return 1
	(( 10#${currentMajor} > 10#${minimalMajor} )) && return 0
	(( 10#${currentMinor} >= 10#${minimalMinor} ))
}

function fz:core::commands()
{
	local fn=
	local cmd=

	while IFS= read -r fn ; do

		cmd=${fn#fz::}

		[[ ${cmd} == ${cmd}:* ]] && continue                # skip nested functions (e.g. fz::git::help)
		command -v "${cmd}" &>/dev/null || continue         # keep only functions whose command is valid

		printf '%s\n' "${cmd}"

	done < <( compgen -A function fz:: ) | sort
}

function public:fz:core::completion()
{
	local cmd=${1:-}

	command -v "${cmd}" &>/dev/null || return 1
	declare -F public:fz::"${cmd}"::fz::completion &>/dev/null || return 0

	public:fz::"${cmd}"::fz::completion
}

function fz:core::completion::bash()
{
	local cmdList=

	cmdList=$( fz:core::commands )
	cmdList=${cmdList//$'\n'/ }

	cat <<- HEREDOC
	_fz_completion() {
		local cur="\${COMP_WORDS[COMP_CWORD]}"
		local command="\${COMP_WORDS[1]}"
		local commands="-h --help -V --version ${cmdList}"

		if [[ \${COMP_CWORD} -eq 1 ]] ; then
			COMPREPLY=( \$( compgen -W "\${commands}" -- "\${cur}" ) )
		else
			local completions="\$( fz public:fz:core::completion "\${command}" )"
			COMPREPLY=( \$( compgen -W "\${completions}" -- "\${cur}" ) )
		fi
	}

	complete -F _fz_completion fz
	HEREDOC
}

function fz:core::completion::zsh()
{
	local cmdList=
	cmdList=$( fz:core::commands | awk '{ printf "\t\t\"%s:Run fz %s\"\n", $0, $0 }' )

	cat <<- HEREDOC
	#compdef fz

	_fz() {
		local -a commands=(
			"-h:Show help"
			"--help:Show help"
			"-V:Show version"
			"--version:Show version"
	${cmdList}
		)

		if (( CURRENT == 2 )) ; then
			_describe 'command' commands
			return
		fi

		local command="\${words[2]}"
		local -a completions=( \$( fz public:fz:core::completion "\${command}" ) )
		_describe 'completion' completions
	}

	compdef _fz fz
	HEREDOC
}

function fz:core::dispatch()
{
	local arg=
	local returnCode=0
	local fzfPreview="$0 public:fz::{}::fz::help | awk '{ sub( /^    /, \"\" ) ; print }'"

	arg=$( fz:api::fzf --height=30% --preview="${fzfPreview}" --preview-window=right:70% --prompt="${APP_NAME} > " --query="${1:-}" --reverse --select-1 <<< "$( fz:core::commands )" )

	[[ -n ${arg} ]] && {

		[[ -n ${1:-} ]] && shift

		fz:core::hook onInit "${arg}"
		fz:core::theme

		fz:core::hook onStart "${arg}"

		fz::"${arg}" "$@"
		returnCode=$?

		fz:core::hook onExit "${arg}"
	}

	return ${returnCode}
}

function fz:core::help()
{
	local binBatcat=
	binBatcat=$( fz:api::command batcat bat )

	if [[ -n ${binBatcat} ]] ; then
		fz:core::theme
		fz:core::help::text 2>&1 | ${binBatcat} --language=help --paging=never --style=plain
	else
		fz:core::help::text
	fi
}

function fz:core::help::text()
{
	local cmds=
	cmds=$( fz:core::commands )

	fz:core::version

	cat <<- HEREDOC

	Pipe commands to FZF.

	Usage:
	    ${APP_NAME} [COMMAND] [ARGUMENTS]
	    ${APP_NAME} [OPTION]

	Commands:

	$( awk '{ print "    " $0 }' <<< "${cmds}" )

	Command arguments:
	$(
		local helpFunction=

		local cmd= ; while IFS= read -r cmd ; do
			helpFunction=public:fz::"${cmd}"::fz::help
			declare -F "${helpFunction}" &>/dev/null && printf '\n' && "${helpFunction}"
		done <<< "${cmds}"
	)

	Options:

	    -h, --help                display this help
	    -V, --version             output version information
	HEREDOC
}

function fz:core::hook()
{
	local hook=$1
	local cmd=$2

	declare -F fz::"${cmd}"::fz::hook::"${hook}" &>/dev/null && fz::"${cmd}"::fz::hook::"${hook}" || :
}

function fz:core::main()
{
	local arg=${1:-}

	case ${arg} in
		--bash-completion)
			fz:core::completion::bash ;;

		--zsh-completion)
			fz:core::completion::zsh ;;

		-h|--help)
			fz:core::help ;;

		-V|--version)
			fz:core::version ;;

		public:fz:*)
			shift
			${arg} "$@"                                     # public exposed functions
		;;

		*)
			fz:core::check || return $?                     # validate runtime requirements
			fz:core::dispatch "$@"
		;;
	esac

	return $?
}

function fz:core::theme()
{
	function fz:core::theme() { : ; }                       # callable only once

	local -r DEFAULT_THEME=Dracula

	local -A fzPalette=( )
	local -A rgb=( )
	local -A arrTheme=(
		["Catppuccin Mocha"]=fz:theme::catppuccinMocha
		["Dracula"]=fz:theme::dracula
		["Monokai Extended Bright"]=fz:theme::monokaiExtendedBright
		["Nord"]=fz:theme::nord
		["Visual Studio Dark+"]=fz:theme::visualStudioDarkPlus
	)

	local fzThemeName=${FZ_THEME:-${DEFAULT_THEME}}
	local fnTheme=${arrTheme[${fzThemeName}]:-}

	[[ -n ${fnTheme} ]] || {
		fzThemeName=${DEFAULT_THEME}
		fnTheme=${arrTheme[${fzThemeName}]}
	}

	"${fnTheme}" fzPalette                                  # load theme
	export FZ_COLOR_RESET=$'\x1b[0m'

	# convert the hexadecimal palette to RGB and ANSI
	local color hex ; for color in PRIMARY SECONDARY ACCENT EMPHASIS STRONG MUTED ; do

		hex=${fzPalette[${color}]#\#}
		rgb[${color}]="$((16#${hex:0:2}));$((16#${hex:2:2}));$((16#${hex:4:2}))"

		printf -v "FZ_COLOR_${color}" '\e[38;2;%sm' "${rgb[${color}]}"
		export "FZ_COLOR_${color}"
	done

	export FZ_RIPGREP_COLORS="--colors=path:fg:${rgb[SECONDARY]//;/,} --colors=line:fg:${rgb[PRIMARY]//;/,} --colors=column:fg:${rgb[PRIMARY]//;/,} --colors=match:fg:${rgb[ACCENT]//;/,}"

	export BAT_THEME=${fzThemeName}
	export FZF_DEFAULT_OPTS="${FZF_DEFAULT_OPTS:-} \
		--color=fg:${fzPalette[STRONG]},hl:${fzPalette[SECONDARY]} \
		--color=fg+:${fzPalette[STRONG]},hl+:${fzPalette[SECONDARY]} \
		--color=info:${fzPalette[EMPHASIS]},prompt:${fzPalette[PRIMARY]},pointer:${fzPalette[ACCENT]} \
		--color=marker:${fzPalette[ACCENT]},spinner:${fzPalette[EMPHASIS]},header:${fzPalette[MUTED]} \
	"
	export GREP_COLORS="ms=01;38;2;${rgb[ACCENT]}:mc=01;38;2;${rgb[ACCENT]}:fn=38;2;${rgb[PRIMARY]}:ln=38;2;${rgb[SECONDARY]}:bn=38;2;${rgb[MUTED]}:se=38;2;${rgb[MUTED]}"
}

# shellcheck disable=SC2034                                 # SC2034: foo appears unused. Verify it or export it.
# shellcheck disable=SC2178                                 # SC2178: Variable was used as an array but is now assigned a string.
{
	function fz:theme::catppuccinMocha() {
		local -n ref=$1
		ref=( [PRIMARY]='#89DCEB' [SECONDARY]='#CBA6F7' [ACCENT]='#F5C2E7' [EMPHASIS]='#F9E2AF' [STRONG]='#CDD6F4' [MUTED]='#6C7086' )
	}

	function fz:theme::dracula() {
		local -n ref=$1
		ref=( [PRIMARY]='#8BE9FD' [SECONDARY]='#BD93F9' [ACCENT]='#FF79C6' [EMPHASIS]='#F1FA8C' [STRONG]='#F8F8F2' [MUTED]='#6272A4' )
	}

	function fz:theme::monokaiExtendedBright() {
		local -n ref=$1
		ref=( [PRIMARY]='#66D9EF' [SECONDARY]='#AE81FF' [ACCENT]='#F92672' [EMPHASIS]='#E6DB74' [STRONG]='#F8F8F2' [MUTED]='#75715E' )
	}

	function fz:theme::nord() {
		local -n ref=$1
		ref=( [PRIMARY]='#88C0D0' [SECONDARY]='#81A1C1' [ACCENT]='#B48EAD' [EMPHASIS]='#EBCB8B' [STRONG]='#ECEFF4' [MUTED]='#4C566A' )
	}

	function fz:theme::visualStudioDarkPlus() {
		local -n ref=$1
		ref=( [PRIMARY]='#569CD6' [SECONDARY]='#9CDCFE' [ACCENT]='#C586C0' [EMPHASIS]='#DCDCAA' [STRONG]='#D4D4D4' [MUTED]='#808080' )
	}
}

function fz:core::version() { printf '%s %s\n' "${APP_NAME}" "${VERSION}" ; }

[[ ${BASH_SOURCE[0]} != "$0" ]] || fz:core::main "$@"
